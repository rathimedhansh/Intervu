DATABASE_URL=sqlite:///./app.db
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Auth (JWT). Generate a real secret for any non-local environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real value here — this file is an example only.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Resume uploads
RESUME_UPLOAD_DIR=uploads/resumes
RESUME_MAX_SIZE_BYTES=5242880
RESUME_MAX_PAGES=10
RESUME_MAX_TEXT_CHARS=20000

# Password reset. No email provider is wired up yet — in dev mode the reset
# link is logged server-side AND returned in the API response so the flow
# works without an inbox. Before deploying to real users: wire an actual
# mailer, send the link there instead, and set this to false.
PASSWORD_RESET_DEV_MODE=true
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:5173
